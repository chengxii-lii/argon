{
  "manifest_version": 3,
  "name": "argon",
  "version": "1.5",
  "description": "Ctrl+T opens a fast command palette on the page you're on: history first, then Google. Made for Helium, with its !bangs.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["history", "tabs", "scripting", "storage", "favicon", "sessions"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/palette.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Open argon (set Ctrl+T in chrome://extensions/shortcuts)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "open-palette": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "Open the palette (set this to Ctrl+T)"
    },
    "close-tab": {
      "description": "Close tab, but never your last one (set this to Ctrl+W)"
    }
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
